/// Credential document categories. Platform rows mirror legacy DOCUMENT_CATEGORIES keys.
/// Tenant rows are client-specific custom categories and never leak across tenants.
model CredentialCategory {
  id                      String         @id @default(cuid())
  scope                   DirectoryScope @default(PLATFORM)
  tenantId                String?
  tenant                  Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  description             String?
  requiredDefault         Boolean        @default(false)
  tracksExpiration        Boolean        @default(false)
  defaultWarningDays      Int?
  applicableProviderTypes Json?
  applicableSpecialties   Json?
  documentTypes           Json?
  sortOrder               Int            @default(0)
  status                  RecordStatus   @default(ACTIVE)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  /// Uniqueness for platform codes and tenant codes is enforced in SQL partial indexes + service layer.
  @@index([scope, code])
  @@index([tenantId, code])
  @@index([scope, status])
  @@index([tenantId, status])
}

/// Tenant-owned payer operational contacts (isolated per client).
