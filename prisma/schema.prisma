  practice    Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  status      CaseStatus @default(DRAFT)
  assignedTo  String?
  dueAt       DateTime?
  submittedAt DateTime?
  decisionAt  DateTime?
  decisionBy  String?
  decisionReason String?
  checklist   Json?
  notes       String?
  statusHistory StatusHistory[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, dueAt])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Payer {
  id          String @id @default(cuid())
  name        String
  legalName   String?
  payerCode   String?
  payerType   String?
  website     String?
  phone       String?
  fax         String?
  email       String?
  address     Json?
  notes       String?
  status      RecordStatus @default(ACTIVE)
  plans       PayerPlan[]
  contacts    PayerContact[]
