  planCode           String?
  planType           String?
  /// Preserved legacy checklist JSON. Structured requirements also live in PayerRequirement.
  checklist          Json?
  stateApplicability String?
  metadata           Json?
  status             RecordStatus @default(ACTIVE)
  enrollments        EnrollmentApplication[]
  contacts           PayerContact[]
  requirements       PayerRequirement[]
  revalidations      EnrollmentRevalidation[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([payerId, name])
  @@index([status])
  @@index([payerId, status])
}

model EnrollmentApplication {
  id            String @id @default(cuid())
  applicationNo String @unique
  subject       String?
  tenantId      String?
  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  providerId    String?
  provider      Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  practiceId    String?
  practice      Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  /// Optional billing entity for group/billing enrollment context (tenant-scoped).
  billingEntityId String?
  billingEntity   BillingEntity? @relation(fields: [billingEntityId], references: [id], onDelete: SetNull)
  /// INDIVIDUAL | GROUP | FACILITY | REASSIGNMENT | OTHER
  enrollmentType String @default("INDIVIDUAL")
  payerPlanId   String
  payerPlan     PayerPlan @relation(fields: [payerPlanId], references: [id], onDelete: Restrict)
  status        EnrollmentStatus @default(NOT_STARTED)
  assignedTo    String?
  dueAt         DateTime?
  /// Internal preparation started (not payer submission).
  preparedAt    DateTime?
  submittedAt   DateTime?
  acknowledgedAt DateTime?
  referenceNo   String?
  lastFollowUpAt DateTime?
  nextFollowUpAt DateTime?
  effectiveAt   DateTime?
  revalidationAt DateTime?
  decisionAt    DateTime?
  decisionReason String?
  terminatedAt  DateTime?
  terminationReason String?
  /// Linked evidence documents (must be AVAILABLE to count as trusted).
  submissionEvidenceDocumentId String?
  acknowledgmentEvidenceDocumentId String?
  decisionEvidenceDocumentId String?
  checklist     Json?
  notes         String?
  /// GPA-only internal notes — never expose on client/provider APIs.
  internalNotes String?
  highlighted   Boolean  @default(false)
  statusHistory StatusHistory[]
  tasks         Task[]
  activities    EnrollmentActivity[]
  approvalDetails EnrollmentApprovalDetails?
  documents     Document[]
  packets       EnrollmentPacket[]
  submissions   EnrollmentSubmission[]
  communications EnrollmentCommunication[]
  externalIntegrationOperations ExternalIntegrationOperation[]
  revalidations EnrollmentRevalidation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, nextFollowUpAt])
  @@index([organizationId, status])
  @@index([providerId, payerPlanId])
  @@index([facilityId, status])
  @@index([highlighted])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, enrollmentType, status])
  @@index([billingEntityId])
  @@index([tenantId, providerId, payerPlanId, facilityId])
}

model EnrollmentActivity {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   EnrollmentApplication @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  activityType String   @default("MESSAGE")
  metadata     Json?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attachments  EnrollmentActivityAttachment[]
  reads        EnrollmentActivityRead[]
  @@index([enrollmentId, createdAt])
  @@index([enrollmentId, deletedAt])
  @@index([authorId, createdAt])
}

model EnrollmentActivityAttachment {
  id         String @id @default(cuid())
  activityId String
  activity   EnrollmentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([activityId, documentId])
  @@index([documentId])
}

model EnrollmentActivityRead {
  id         String   @id @default(cuid())
  activityId String
  activity   EnrollmentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())
  @@unique([activityId, userId])
  @@index([userId, readAt])
}

model EnrollmentApprovalDetails {
  id                String   @id @default(cuid())
  enrollmentId      String   @unique
  enrollment        EnrollmentApplication @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payerEnrollmentId String?
  effectiveAt       DateTime?
  revalidationAt    DateTime?
  notes             String?
  createdById       String?
  createdBy         User?    @relation("ApprovalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?    @relation("ApprovalUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Task {
  id             String @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  priority       Priority @default(NORMAL)
  dueAt          DateTime?
  assignedToId   String?
  assignedTo     User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenantId       String?
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  practiceId     String?
  practice       Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  facilityId     String?
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  caseId         String?
  credentialingCase CredentialingCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  enrollment     EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  /// Phase 3C: distinguish generated credentialing gaps from ordinary tasks.
  source         String?
  /// Stable key to prevent duplicate open gaps for the same underlying issue.
  fingerprint    String?
  /// Related record type/id for gap navigation (non-sensitive).
  relatedType    String?
  relatedId      String?
  /// Phase 4C follow-up typing (INITIAL_PAYER_CHECK, STATUS_CHECK, …).
  followUpType   String?
  completedAt    DateTime?
  completionNotes String?
  submissionId   String?
  submission     EnrollmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  communicationId String?
  communication  EnrollmentCommunication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([tenantId, fingerprint])
  @@index([status, dueAt])
  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, source, status])
  @@index([providerId, source, status])
  @@index([tenantId, followUpType, status])
  @@index([submissionId])
  @@index([communicationId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

model StatusHistory {
  id           String @id @default(cuid())
  fromStatus   String?
  toStatus     String
  changedBy    String?
  reason       String?
  /// Phase 4A: typed enrollment/case event (e.g. APPLICATION_SUBMITTED).
  eventType    String?
  actorRole    String?
  /// Non-sensitive metadata only (never passwords, Tax ID, SSN, banking).
  metadata     Json?
  caseId       String?
  credentialingCase CredentialingCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([caseId, createdAt])
  @@index([enrollmentId, createdAt])
  @@index([eventType, createdAt])
}

model AuditEvent {
  id             String @id @default(cuid())
  actorId        String?
  actor          User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId       String?
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

enum IntakeStatus {
  DRAFT
  SENT
  /// External provider invited (Phase 2B). Distinct from legacy SENT for staff workflows.
  INVITED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum DocumentSecurityStatus {
  UPLOADED
  QUARANTINED
  SCANNING
  AVAILABLE
  REJECTED
  DELETED
}

enum ProviderIdentityMatch {
  NEW
  MATCHED
  AMBIGUOUS
  NONE
}

/// Shared verification lifecycle for structured professional history (Phase 3A).
/// Document upload alone never implies VERIFIED.
enum HistoryVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  UNABLE_TO_VERIFY
}

enum ProfessionalHistorySection {
  EDUCATION
  RESIDENCY
  FELLOWSHIP
  BOARD_CERTIFICATION
  PROFESSIONAL_CERTIFICATION
  EMPLOYMENT
  HOSPITAL_AFFILIATION
  MALPRACTICE
}

enum HistoryCompletionStatus {
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
  TRANSFERRED
  OTHER
}

enum HistoryRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  CURRENT
  EXPIRED
  PENDING
}

enum IntakeKind {
  PROVIDER
  PRACTICE
  FACILITY
  ORGANIZATION
  COMBINED
}

model IntakeRequest {
  id               String       @id @default(cuid())
  referenceNo      String       @unique
  kind             IntakeKind   @default(PROVIDER)
  status           IntakeStatus @default(DRAFT)
  tenantId         String?
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?        @relation("IntakeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?        @relation("IntakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// External provider user assigned to this intake (Phase 2B). Not a TenantMembership.
  providerUserId   String?
  providerUser     User?        @relation("IntakeProviderUser", fields: [providerUserId], references: [id], onDelete: SetNull)
  invitedEmail     String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  /// Working draft payload (provider editable while draft / changes requested).
  payload          Json?
  /// Latest submitted snapshot (denormalized for convenience). Historical versions in IntakeSubmission.
  submittedPayload Json?
  /// Version number of the latest IntakeSubmission row.
  currentSubmissionVersion Int @default(0)
  missingFields    Json?
  /// Client-visible review comments (safe for provider + client portal).
  reviewerComments String?
  /// GPA-only notes — never exposed to EXTERNAL_PROVIDER or CLIENT_USER.
  internalNotes    String?
  rejectionReason  String?
  identityMatch    ProviderIdentityMatch @default(NONE)
  matchedProviderId String?
  convertedProviderId  String?
  convertedPracticeId  String?
  convertedFacilityId  String?
  convertedOrganizationId String?
  sentAt           DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  changesRequestedAt DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  convertedAt      DateTime?
  lastSavedAt      DateTime?
  notes            String?
  events           IntakeEvent[]
  invitations      ProviderIntakeInvitation[]
  documents        Document[]
  submissions      IntakeSubmission[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([providerUserId, status])
  @@index([invitedEmail])
}

/// Immutable submission versions for provider intake (Phase 2C).
/// Each submit/resubmit appends a row; prior versions are never overwritten.
model IntakeSubmission {
  id              String   @id @default(cuid())
  intakeRequestId String
  intakeRequest   IntakeRequest @relation(fields: [intakeRequestId], references: [id], onDelete: Cascade)
  version         Int
  payload         Json
  submittedById   String?
  submittedAt     DateTime @default(now())
  /// Reviewer action against this version, if any.
  reviewAction    String?
  reviewComments  String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime @default(now())
  @@unique([intakeRequestId, version])
  @@index([intakeRequestId, submittedAt])
}

model IntakeEvent {
  id        String   @id @default(cuid())
  intakeId  String
  intake    IntakeRequest @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?
  detail    Json?
  createdAt DateTime @default(now())
  @@index([intakeId, createdAt])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
