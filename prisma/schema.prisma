generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREDENTIALING_MANAGER
  CREDENTIALING_SPECIALIST
  ENROLLMENT_SPECIALIST
  APPROVER
  AUDITOR
  READ_ONLY
  /// External client portal user (tenant-scoped). Never a GPA platform administrator.
  CLIENT_USER
  /// External healthcare provider — intake-scoped access only; never platform/client admin.
  EXTERNAL_PROVIDER
}

enum TenantOnboardingStatus {
  NOT_STARTED
  INVITED
  ACCOUNT_ACTIVATED
  PROFILE_PENDING
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvitationDeliveryStatus {
  NOT_SENT
  SENT
  FAILED
}

/// Platform-level GPA staff roles remain on User.role (including ADMIN).
/// TenantRole is client-account scoped and must not grant cross-tenant access.
enum TenantRole {
  TENANT_ADMIN
  CREDENTIALING_MANAGER
  CREDENTIALING_SPECIALIST
  ENROLLMENT_SPECIALIST
  APPROVER
  AUDITOR
  READ_ONLY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantMembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum RecordStatus {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}
enum CaseStatus {
  DRAFT
  INFORMATION_NEEDED
  UNDER_REVIEW
  VERIFICATION_PENDING
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  ON_HOLD
}
enum EnrollmentStatus {
  NOT_STARTED
  PREPARING
  READY_TO_SUBMIT
  SUBMITTED
  /// Payer acknowledged receipt (distinct from submission and from approval).
  ACKNOWLEDGED
  PAYER_REVIEW
  ADDITIONAL_INFORMATION_NEEDED
  APPROVED
  /// Participation is effective as of effectiveAt (requires prior approval basis).
  EFFECTIVE
  DENIED
  WITHDRAWN
  TERMINATED
  CLOSED
}
enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Internal profile review lifecycle (Phase 3C). Distinct from license/history verification
/// and from payer enrollment approval.
enum ProfileReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  CORRECTIONS_REQUESTED
  RESUBMITTED
  COMPLETED
}
enum DocumentStatus {
  MISSING
  RECEIVED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CREDENTIALING_SPECIALIST)
  active       Boolean  @default(true)
  employeeCode String?  @unique
  department   String?
  jobTitle     String?
  phone        String?
  timezone     String?  @default("UTC")
  workSchedule Json?
  managerId    String?
  manager      User?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("EmployeeManager")
  organizations UserOrganization[]
  tenantMemberships TenantMembership[]
  leaveRequests LeaveRequest[] @relation("LeaveApplicant")
  leaveReviews  LeaveRequest[] @relation("LeaveReviewer")
  leaveBalances LeaveBalance[]
  attendance    AttendanceRecord[]
  notifications Notification[]
  taskComments  TaskComment[]
  intakeAssigned IntakeRequest[] @relation("IntakeAssignee")
  intakeCreated  IntakeRequest[] @relation("IntakeCreator")
  enrollmentActivities EnrollmentActivity[]
  enrollmentActivityReads EnrollmentActivityRead[]
  enrollmentApprovalsCreated EnrollmentApprovalDetails[] @relation("ApprovalCreator")
  enrollmentApprovalsUpdated EnrollmentApprovalDetails[] @relation("ApprovalUpdater")
  @@index([managerId])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditEvents  AuditEvent[]
  tasks        Task[]   @relation("TaskAssignee")
  createdTasks Task[]   @relation("TaskCreator")
  createdDocuments Document[] @relation("DocumentCreator")
  dataQualityIssuesAssigned DataQualityIssue[] @relation("DataQualityAssignee")
  dataQualityIssuesResolved DataQualityIssue[] @relation("DataQualityResolver")
  invitationsSent TenantInvitation[] @relation("InvitationInviter")
  providerIntakeInvitationsSent ProviderIntakeInvitation[] @relation("ProviderIntakeInviter")
  providerIntakes IntakeRequest[] @relation("IntakeProviderUser")
  payerRequirementsReviewed PayerRequirement[] @relation("PayerRequirementReviewer")
  enrollmentPacketsCreated  EnrollmentPacket[] @relation("EnrollmentPacketCreator")
  enrollmentSubmissionsCreated EnrollmentSubmission[] @relation("EnrollmentSubmissionCreator")
  enrollmentSubmissionsConfirmed EnrollmentSubmission[] @relation("EnrollmentSubmissionConfirmer")
  enrollmentCommunicationsCreated EnrollmentCommunication[] @relation("EnrollmentCommunicationCreator")
  externalIntegrationsConfigured ExternalIntegration[] @relation("ExternalIntegrationConfigurator")
  providerIntegrationAuthsGranted ProviderIntegrationAuthorization[] @relation("ProviderIntegrationAuthGranter")
  providerIntegrationAuthEvents ProviderIntegrationAuthorizationEvent[] @relation("ProviderIntegrationAuthEventActor")
  externalIntegrationOperationsInitiated ExternalIntegrationOperation[] @relation("ExternalIntegrationOperationInitiator")
  revalidationsAssigned EnrollmentRevalidation[] @relation("RevalidationAssignee")
  revalidationsCreated EnrollmentRevalidation[] @relation("RevalidationCreator")
  revalidationEvents EnrollmentRevalidationEvent[] @relation("RevalidationEventActor")
}

/// Independent client account on the GPA platform. Distinct from Organization
/// (a legal/business entity that may belong to a tenant).
model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  status        TenantStatus @default(ACTIVE)
  /// Client onboarding lifecycle (separate from TenantStatus).
  onboardingStatus TenantOnboardingStatus @default(NOT_STARTED)
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  /// GPA-only notes — never exposed on client portal APIs.
  internalNotes String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   TenantMembership[]
  invitations   TenantInvitation[]
  organizations Organization[]
  providers     TenantProvider[]
  documents     Document[]
  cases         CredentialingCase[]
  enrollments   EnrollmentApplication[]
  tasks         Task[]
  intakeRequests IntakeRequest[]
  providerIntakeInvitations ProviderIntakeInvitation[]
  auditEvents   AuditEvent[]
  payerContacts PayerContact[]
  billingEntities BillingEntity[]
  credentialCategories CredentialCategory[]
  payerRequirements PayerRequirement[]
  enrollmentPackets EnrollmentPacket[]
  enrollmentSubmissions EnrollmentSubmission[]
  enrollmentCommunications EnrollmentCommunication[]
  externalIntegrations ExternalIntegration[]
  providerIntegrationAuthorizations ProviderIntegrationAuthorization[]
  externalIntegrationOperations ExternalIntegrationOperation[]
  enrollmentRevalidations EnrollmentRevalidation[]
  dataQualityIssues DataQualityIssue[]
  educationHistory              ProviderEducation[]
  residencyHistory              ProviderResidency[]
  fellowshipHistory             ProviderFellowship[]
  boardCertificationHistory     ProviderBoardCertification[]
  professionalCertificationHistory ProviderProfessionalCertification[]
  employmentHistory             ProviderEmployment[]
  hospitalAffiliationHistory    ProviderHospitalAffiliation[]
  malpracticeHistory            ProviderMalpracticePolicy[]
  professionalHistoryDocuments  ProfessionalHistoryDocument[]
  professionalHistoryVerifications ProfessionalHistoryVerificationEvent[]
  licenses                      License[]
  profileReviews                ProviderProfileReview[]
  credentialingQaScans          CredentialingQaScan[]
  @@index([status])
  @@index([onboardingStatus])
}

/// Secure invitation for external provider intake. Distinct from TenantInvitation
/// (client staff membership). Does NOT create TenantMembership.
model ProviderIntakeInvitation {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intakeRequestId String
  intakeRequest   IntakeRequest            @relation(fields: [intakeRequestId], references: [id], onDelete: Cascade)
  email           String
  /// Optional known provider identity hint (does not grant access by itself).
  knownProviderId String?
  invitedById     String?
  invitedBy       User?                    @relation("ProviderIntakeInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash       String                   @unique
  status          InvitationStatus         @default(PENDING)
  deliveryStatus  InvitationDeliveryStatus @default(NOT_SENT)
  deliveryError   String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  lastSentAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  @@index([tenantId, status])
  @@index([intakeRequestId, status])
  @@index([email, status])
  @@index([expiresAt])
}

/// Secure client invitation. Raw token is never stored — only tokenHash.
model TenantInvitation {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  role            TenantRole
  invitedById     String?
  invitedBy       User?                    @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash       String                   @unique
  status          InvitationStatus         @default(PENDING)
  deliveryStatus  InvitationDeliveryStatus @default(NOT_SENT)
  deliveryError   String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  lastSentAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  @@index([tenantId, status])
  @@index([email, status])
  @@index([expiresAt])
}

/// Explicit tenant ownership for a Provider identity. Required for tenant isolation.
/// A provider may belong to multiple tenants only via separate links; Phase 0B
/// still keeps the shared Provider row for identity continuity, but access is
/// denied unless a TenantProvider link exists for the active tenant.
model TenantProvider {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, providerId])
  @@index([providerId])
  @@index([tenantId])
}

model TenantMembership {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      TenantRole
  status    TenantMembershipStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id             String   @id @default(cuid())
  /// Optional until Phase 0B tenant assignment/isolation. Null = unassigned legacy row.
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  legalName      String
  dba            String?
  taxId          String?
  establishedAt  DateTime?
  status         RecordStatus @default(ACTIVE)
  contactName    String?
  contactTitle   String?
  phone          String?
  fax            String?
  email          String?
  mailingAddress Json?
  ownership      Json?
  bankName       String?
  bankAccountTitle String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankContactName String?
  bankContactPhone String?
  bankContactEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  practices      Practice[]
  facilities     Facility[]
  providerAffiliations ProviderOrganization[]
  enrollments    EnrollmentApplication[]
  documents      Document[]
  auditEvents    AuditEvent[]
  members        UserOrganization[]
  tasks          Task[]
  intakeRequests IntakeRequest[]
  billingEntities BillingEntity[]
  @@index([tenantId])
  @@index([tenantId, status])
}

model Practice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  legalName      String?
  npi            String?
  taxId          String?
  dba            String?
  taxonomyCode   String?
  establishedAt  DateTime?
  contactName    String?
  contactTitle   String?
  phone          String?
  fax            String?
  email          String?
  mailingAddress Json?
  primaryAddress Json?
  bankName       String?
  bankAccountTitle String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankContactName String?
  bankContactPhone String?
  bankContactEmail String?
  status         RecordStatus @default(ACTIVE)
  owners         PracticeOwner[]
  providers      ProviderPractice[]
  facilities     Facility[]
  cases          CredentialingCase[]
  enrollments    EnrollmentApplication[]
  documents      Document[]
  tasks          Task[]
  billingEntityLinks BillingEntityPractice[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
  @@index([npi])
}

model PracticeOwner {
  id                 String   @id @default(cuid())
  practiceId         String
  practice           Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name               String
  ownershipPercent   Decimal  @db.Decimal(5, 2)
  ssn                String?
  dateOfBirth        DateTime?
  ownershipDate      DateTime?
  placeOfBirth       String?
  address            Json?
  phone              String?
  fax                String?
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([practiceId])
}

enum ContactKind {
  PERSON
  ORGANIZATION
}

model Facility {
  id          String   @id @default(cuid())
  practiceId  String?
  practice    Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name        String
  npi         String?
  contactName String?
  contactTitle String?
  phone       String?
  fax         String?
  email       String?
  address     Json?
  schedule    Json?
  status      RecordStatus @default(ACTIVE)
  providers   ProviderFacility[]
  contacts    FacilityContact[]
  documents   Document[]
  documentLinks DocumentFacility[]
  enrollments EnrollmentApplication[]
  tasks       Task[]
  hospitalAffiliations ProviderHospitalAffiliation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([practiceId])
  @@index([organizationId])
}

model FacilityContact {
  id               String      @id @default(cuid())
  facilityId       String
  facility         Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  kind             ContactKind @default(PERSON)
  name             String?
  title            String?
  organizationName String?
  email            String?
  phone            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@index([facilityId, kind])
}

model Provider {
  id                 String   @id @default(cuid())
  firstName          String
  middleName         String?
  lastName           String
  npi                String?  @unique
  dateOfBirth        DateTime?
  placeOfBirth       String?
  ssn                String?
  citizenship        String?
  gender             String?
  email              String?
  homePhone          String?
  workPhone          String?
  address            Json?
  /// Legacy free-text specialties retained for compatibility.
  primarySpecialty   String?
  secondarySpecialty String?
  primarySpecialtyId String?
  primarySpecialtyRef Specialty? @relation("ProviderPrimarySpecialty", fields: [primarySpecialtyId], references: [id], onDelete: SetNull)
  secondarySpecialtyId String?
  secondarySpecialtyRef Specialty? @relation("ProviderSecondarySpecialty", fields: [secondarySpecialtyId], references: [id], onDelete: SetNull)
  taxonomyCode       String?
  professionalType   String?
  supervisorName     String?
  status             RecordStatus @default(PENDING)
  licenses           License[]
  practices          ProviderPractice[]
  organizations      ProviderOrganization[]
  facilities         ProviderFacility[]
  cases              CredentialingCase[]
  enrollments        EnrollmentApplication[]
  documents          Document[]
  documentLinks      DocumentProvider[]
  tasks              Task[]
  tenantLinks        TenantProvider[]
  specialties        ProviderSpecialty[]
  educationHistory   ProviderEducation[]
  residencyHistory   ProviderResidency[]
  fellowshipHistory  ProviderFellowship[]
  boardCertifications ProviderBoardCertification[]
  professionalCertifications ProviderProfessionalCertification[]
  employmentHistory  ProviderEmployment[]
  hospitalAffiliations ProviderHospitalAffiliation[]
  malpracticePolicies ProviderMalpracticePolicy[]
  professionalHistoryDocuments ProfessionalHistoryDocument[]
  professionalHistoryVerifications ProfessionalHistoryVerificationEvent[]
  profileReviews     ProviderProfileReview[]
  integrationAuthorizations ProviderIntegrationAuthorization[]
  externalIntegrationOperations ExternalIntegrationOperation[]
  enrollmentRevalidations EnrollmentRevalidation[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([lastName, firstName])
  @@index([status])
  @@index([primarySpecialtyId])
  @@index([secondarySpecialtyId])
}

model ProviderPractice {
  providerId String
  practiceId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  affiliationTitle String?
  effectiveAt DateTime?
  endAt DateTime?
  @@id([providerId, practiceId])
}

model ProviderFacility {
  providerId String
  facilityId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  approvalStatus String?
  effectiveAt DateTime?
  endAt DateTime?
  @@id([providerId, facilityId])
}

model ProviderOrganization {
  id             String @id @default(cuid())
  providerId     String
  organizationId String
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affiliationTitle String?
  effectiveAt    DateTime?
  endAt          DateTime?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([providerId, organizationId])
  @@index([organizationId, status])
}

model License {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// Tenant ownership for isolation. Backfilled from TenantProvider when known.
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// Legacy free-text type retained for compatibility.
  type          String
  licenseTypeId String?
  licenseType   LicenseType? @relation(fields: [licenseTypeId], references: [id], onDelete: SetNull)
  number        String?
  /// Legacy free-text state retained for compatibility.
  state         String?
  usStateId     String?
  usState       UsState? @relation(fields: [usStateId], references: [id], onDelete: SetNull)
  issuedAt      DateTime?
  expiresAt     DateTime?
  /// Operational/document status (legacy). Prefer verificationStatus + computed attention for lifecycle.
  status        DocumentStatus @default(RECEIVED)
  issuingBody   String?
  notes         String?
  isPrimary     Boolean  @default(false)
  archived      Boolean  @default(false)
  suspended     Boolean  @default(false)
  /// Manual review lifecycle — upload alone never implies VERIFIED.
  verificationStatus HistoryVerificationStatus @default(NOT_SUBMITTED)
  verifiedAt    DateTime?
  verifiedById  String?
  rejectionReason String?
  reviewerNotes String?
  correctionRequest String?
  documentId    String?
  /// Prior license preserved on renewal (do not overwrite history).
  renewedFromId String?
  renewedFrom   License?  @relation("LicenseRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals      License[] @relation("LicenseRenewal")
  sourceIntakeId String?
  events        LicenseEvent[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([providerId, expiresAt])
  @@index([tenantId, providerId])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, expiresAt])
  @@index([licenseTypeId])
  @@index([usStateId])
  @@index([renewedFromId])
  @@index([archived, suspended])
}

/// Append-only license lifecycle history (Phase 3B).
model LicenseEvent {
  id        String   @id @default(cuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  tenantId  String?
  action    String
  fromStatus String?
  toStatus  String?
  actorId   String?
  reason    String?
  /// Non-sensitive metadata only — never full license numbers.
  detail    Json?
  createdAt DateTime @default(now())
  @@index([licenseId, createdAt])
  @@index([tenantId, createdAt])
}

model Document {
  id             String @id @default(cuid())
  title          String
  type           String
  category       String?
  status         DocumentStatus @default(RECEIVED)
  /// Upload quarantine / availability for consumption (malware scan policy).
  /// New uploads default QUARANTINED until scanner or authorized manual release.
  /// Legacy AVAILABLE rows are preserved; do not bulk-migrate without an approved plan.
  securityStatus DocumentSecurityStatus @default(QUARANTINED)
  storageKey     String?
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  issuedAt       DateTime?
  expiresAt      DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?
  ignored        Boolean @default(false)
  required       Boolean @default(false)
  reportingRequired Boolean @default(false)
  warningDays    Int?
  policyNumber   String?
  perOccurrence  Decimal? @db.Decimal(14, 2)
  aggregate      Decimal? @db.Decimal(14, 2)
  insuranceCompany String?
  namedInsured   String?
  // Banking credential fields (Bank Letter / Voided Check). Sensitive values encrypted at rest.
  bankName         String?
  bankTitle        String?
  bankRoutingNumber String?
  bankAccountType  String?
  bankPhoneNumber  String?
  bankAccountHolder String?
  uploadedAt       DateTime?
  createdById    String?
  createdBy      User? @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Nullable until backfilled; tenant-scoped access denies unmapped rows.
  tenantId       String?
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  practiceId     String?
  practice       Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  facilityId     String?
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  enrollment     EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  intakeRequestId String?
  intakeRequest   IntakeRequest? @relation(fields: [intakeRequestId], references: [id], onDelete: SetNull)
  documentFacilities DocumentFacility[]
  documentProviders  DocumentProvider[]
  activityAttachments EnrollmentActivityAttachment[]
  packetItems        EnrollmentPacketItem[]
  enrollmentSubmissions EnrollmentSubmission[]
  enrollmentCommunications EnrollmentCommunication[]
  providerIntegrationAuthEvidence ProviderIntegrationAuthorization[]
  revalidationEvidence EnrollmentRevalidation[]
  /// Prior file versions retained when a document is replaced (Phase 2C).
  fileRevisions  DocumentFileRevision[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([type, status])
  @@index([category, status])
  @@index([expiresAt])
  @@index([facilityId, category])
  @@index([enrollmentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([intakeRequestId])
  @@index([securityStatus])
}

/// Retains superseded file metadata when a Document is replaced.
/// Physical files under private-uploads are kept for audit; not auto-deleted.
model DocumentFileRevision {
  id             String                 @id @default(cuid())
  documentId     String
  document       Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  storageKey     String?
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  securityStatus DocumentSecurityStatus
  reason         String                 @default("REPLACE")
  createdById    String?
  createdAt      DateTime               @default(now())
  @@index([documentId, createdAt])
}

model DocumentFacility {
  documentId String
  facilityId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@id([documentId, facilityId])
  @@index([facilityId])
}

model DocumentProvider {
  documentId String
  providerId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@id([documentId, providerId])
  @@index([providerId])
}

model CredentialingCase {
