  @@id([billingEntityId, practiceId])
  @@index([practiceId])
}

/// Structured payer/plan requirement definitions (Phase 1A catalog + Phase 4B engine).
/// Does not replace PayerPlan.checklist — checklist JSON is preserved.
/// Requirements must be configured from verified payer sources or authorized GPA decisions.
model PayerRequirement {
  id                    String         @id @default(cuid())
  scope                 DirectoryScope @default(PLATFORM)
  tenantId              String?
  tenant                Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payerId               String?
  payer                 Payer?         @relation(fields: [payerId], references: [id], onDelete: Cascade)
  payerPlanId           String?
  payerPlan             PayerPlan?     @relation(fields: [payerPlanId], references: [id], onDelete: Cascade)
  code                  String?
  title                 String
  description           String?
  /// Category example: PROVIDER_DEMOGRAPHIC, NPI, SPECIALTY, STATE_LICENSE, DEA, BOARD_CERTIFICATION, EDUCATION, RESIDENCY, FELLOWSHIP, PROFESSIONAL_HISTORY, MALPRACTICE, TAX_W9, GROUP_PRACTICE, BILLING_ENTITY, FACILITY, PAYER_APPLICATION_FORM, CORRESPONDENCE, OTHER
  category              String?
  requirementKind       String?
  /// When true, missing item blocks packet readiness. Optional items remain visible.
  isRequired            Boolean        @default(true)
  /// Enrollment types this applies to (empty/null = all): INDIVIDUAL, GROUP, FACILITY, REASSIGNMENT, OTHER
  enrollmentTypes       Json?
  appliesToProviderTypes Json?
  appliesToSpecialties  Json?
  appliesToStates       Json?
  appliesToFacility     Boolean        @default(false)
  appliesToGroup        Boolean        @default(false)
  documentCategoryCode  String?
  tracksExpiration      Boolean        @default(false)
  /// Restricted condition schema (no executable code). Validated by requirementConditions service.
  conditions            Json?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  version               Int            @default(1)
  source                String?
  sourceReference       String?
  sourceVerifiedAt      DateTime?
  lastReviewedById      String?
  lastReviewedBy        User?          @relation("PayerRequirementReviewer", fields: [lastReviewedById], references: [id], onDelete: SetNull)
  lastReviewedAt        DateTime?
  instructions          String?
  sortOrder             Int            @default(0)
  status                RecordStatus   @default(ACTIVE)
  metadata              Json?
  history               PayerRequirementHistory[]
  packetItems           EnrollmentPacketItem[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  @@index([scope, status])
  @@index([tenantId, status])
  @@index([payerId, status])
  @@index([payerPlanId, status])
  @@index([scope, payerPlanId, code])
  @@index([code, version, status])
  @@index([effectiveFrom, effectiveTo])
}

/// Append-only requirement change history (version snapshots).
model PayerRequirementHistory {
  id            String   @id @default(cuid())
  requirementId String
  requirement   PayerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedById   String?
  changeReason  String?
  createdAt     DateTime @default(now())
  @@index([requirementId, version])
  @@index([requirementId, createdAt])
}

enum EnrollmentPacketStatus {
  NOT_EVALUATED
  INCOMPLETE
  EVIDENCE_PENDING
  REVIEW_REQUIRED
  READY_FOR_INTERNAL_SUBMISSION_REVIEW
  BLOCKED
}

enum PacketItemStatus {
  NOT_STARTED
  MISSING
  INFORMATION_AVAILABLE
  EVIDENCE_ATTACHED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  NOT_APPLICABLE
  WAIVED
}

/// Frozen enrollment requirement packet (Phase 4B). Snapshot preserves historical integrity.
/// READY_FOR_INTERNAL_SUBMISSION_REVIEW ≠ payer submission/approval/effective.
model EnrollmentPacket {
  id                 String                 @id @default(cuid())
  enrollmentId       String
  enrollment         EnrollmentApplication  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version            Int                    @default(1)
  status             EnrollmentPacketStatus @default(NOT_EVALUATED)
  payerId            String?
  payerPlanId        String
  enrollmentType     String
  /// Exact applicable requirements at evaluation time (codes, versions, titles, required flags).
  requirementSnapshot Json
  evaluationSummary  Json?
  conflictNotes      String?
  createdById        String?
  createdBy          User?                  @relation("EnrollmentPacketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evaluatedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  items              EnrollmentPacketItem[]
  submissions        EnrollmentSubmission[]
  @@unique([enrollmentId, version])
  @@index([tenantId, enrollmentId])
  @@index([tenantId, status])
  @@index([enrollmentId, status])
}

model EnrollmentPacketItem {
  id                   String          @id @default(cuid())
  packetId             String
  packet               EnrollmentPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  payerRequirementId   String?
  payerRequirement     PayerRequirement? @relation(fields: [payerRequirementId], references: [id], onDelete: SetNull)
  requirementCode      String?
  requirementTitle     String
  category             String?
  isRequired           Boolean         @default(true)
  sortOrder            Int             @default(0)
  status               PacketItemStatus @default(NOT_STARTED)
  applicabilityReason  String?
  /// PROVIDER_NPI | SPECIALTY | LICENSE | DOCUMENT | EDUCATION | RESIDENCY | FELLOWSHIP | BOARD_CERTIFICATION | EMPLOYMENT | HOSPITAL_AFFILIATION | MALPRACTICE | ORGANIZATION | PRACTICE | BILLING_ENTITY | FACILITY | MANUAL
  sourceType           String?
  sourceRecordId       String?
  sourceLabel          String?
  documentId           String?
  document             Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  expiresAt            DateTime?
  reviewNotes          String?
  /// GPA-only internal notes — never expose to client/provider.
  internalNotes        String?
  rejectionReason      String?
  waiverReason         String?
  waivedById           String?
  waivedAt             DateTime?
  verifiedById         String?
  verifiedAt           DateTime?
  requirementVersion   Int?
  /// Frozen requirement fields at packet evaluation.
  snapshot             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  events               EnrollmentPacketItemEvent[]
  @@index([packetId, status])
  @@index([packetId, requirementCode])
  @@index([documentId])
  @@index([payerRequirementId])
}

model EnrollmentPacketItemEvent {
  id         String   @id @default(cuid())
  itemId     String
  item       EnrollmentPacketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  eventType  String
  fromStatus String?
  toStatus   String?
  actorId    String?
  actorRole  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([itemId, createdAt])
}

/// Phase 4C — manual submission attempt tracking (not automated payer integration).
enum EnrollmentSubmissionStatus {
  PREPARED
  CONFIRMED
  CANCELLED
}

model EnrollmentSubmission {
  id                   String                     @id @default(cuid())
  enrollmentId         String
  enrollment           EnrollmentApplication      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attemptNumber        Int
  packetId             String?
  packet               EnrollmentPacket?          @relation(fields: [packetId], references: [id], onDelete: SetNull)
  packetVersion        Int?
  /// PAYER_PORTAL_MANUAL | FAX | MAIL | EMAIL | PHONE | OTHER
  channel              String
  channelExplanation   String?
  submittedAt          DateTime?
  submittedById        String?
  submittedBy          User?                      @relation("EnrollmentSubmissionCreator", fields: [submittedById], references: [id], onDelete: SetNull)
  confirmedById        String?
  confirmedBy          User?                      @relation("EnrollmentSubmissionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt          DateTime?
  referenceNo          String?
  evidenceDocumentId   String?
  evidenceDocument     Document?                  @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  notes                String?
  /// GPA-only confirmation / exception notes.
  internalNotes        String?
  confirmationStatus   EnrollmentSubmissionStatus @default(PREPARED)
  /// Explicit user confirmation that the application was actually sent.
  confirmedSent        Boolean                    @default(false)
  overrideReason       String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  communications       EnrollmentCommunication[]
  tasks                Task[]
  @@unique([enrollmentId, attemptNumber])
  @@index([tenantId, enrollmentId])
  @@index([enrollmentId, submittedAt])
  @@index([tenantId, confirmationStatus])
  @@index([packetId])
  @@index([evidenceDocumentId])
}

model EnrollmentCommunication {
  id                 String                @id @default(cuid())
  enrollmentId       String
  enrollment         EnrollmentApplication @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId       String?
  submission         EnrollmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  /// SUBMISSION_CONFIRMATION | RECEIPT_ACKNOWLEDGEMENT | STATUS_INQUIRY | …
  communicationType  String
  /// PHONE | EMAIL | FAX | PAYER_PORTAL_MANUAL | MAIL | OTHER
  channel            String
  channelExplanation String?
  occurredAt         DateTime              @default(now())
  contactName        String?
  contactDepartment  String?
  referenceNo        String?
  summary            String
  notes              String?
  /// GPA-only — never expose to client/provider.
  internalNotes      String?
  evidenceDocumentId String?
  evidenceDocument   Document?             @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?                 @relation("EnrollmentCommunicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tasks              Task[]
  @@index([tenantId, enrollmentId])
  @@index([enrollmentId, createdAt])
  @@index([communicationType, createdAt])
  @@index([submissionId])
  @@index([evidenceDocumentId])
}

/// Phase 1C — structured directory / reference-data quality issues.
enum DataQualityIssueType {
  DUPLICATE_EXACT
  DUPLICATE_STRONG
  DUPLICATE_POSSIBLE
  BROKEN_RELATIONSHIP
  UNMAPPED_LEGACY
  INVALID_REFERENCE
  MISSING_REQUIRED
  INCONSISTENT_STATUS
  NPI_INVALID
  SPECIALTY_CONFLICT
  CATEGORY_INCONSISTENCY
  OTHER
}

enum DataQualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataQualityIssueStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ACCEPTED_LEGITIMATE
  REOPENED
}

model DataQualityIssue {
  id              String                   @id @default(cuid())
  /// Null = platform-global issue (specialties, payers, etc.).
  tenantId        String?
  tenant          Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issueType       DataQualityIssueType
  severity        DataQualitySeverity      @default(MEDIUM)
  status          DataQualityIssueStatus   @default(OPEN)
  /// Logical directory key: specialties | usStates | licenseTypes | payers | plans | billingEntities | credentialCategories | providers | licenses | documents | enrollments
  directoryType   String
  recordId        String?
  /// Second record for duplicate pairs.
  relatedRecordId String?
  /// Stable fingerprint to prevent duplicate open issues for the same problem.
  fingerprint     String
  title           String
  description     String?
  /// Non-sensitive detection payload (counts, normalized keys, field diffs). Never store raw Tax ID/SSN.
  details         Json?
  assignedToId    String?
  assignedTo      User?                    @relation("DataQualityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById    String?
  resolvedBy      User?                    @relation("DataQualityResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?
  detectedAt      DateTime                 @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  @@unique([fingerprint])
  @@index([tenantId, status])
  @@index([directoryType, status])
  @@index([issueType, status])
  @@index([severity, status])
  @@index([detectedAt])
}

