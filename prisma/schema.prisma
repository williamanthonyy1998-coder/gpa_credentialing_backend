generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREDENTIALING_MANAGER
  CREDENTIALING_SPECIALIST
  ENROLLMENT_SPECIALIST
  APPROVER
  AUDITOR
  READ_ONLY
}
enum RecordStatus {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}
enum CaseStatus {
  DRAFT
  INFORMATION_NEEDED
  UNDER_REVIEW
  VERIFICATION_PENDING
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  ON_HOLD
}
enum EnrollmentStatus {
  NOT_STARTED
  PREPARING
  READY_TO_SUBMIT
  SUBMITTED
  PAYER_REVIEW
  ADDITIONAL_INFORMATION_NEEDED
  APPROVED
  DENIED
  WITHDRAWN
}
enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum DocumentStatus {
  MISSING
  RECEIVED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CREDENTIALING_SPECIALIST)
  active       Boolean  @default(true)
  employeeCode String?  @unique
  department   String?
  jobTitle     String?
  phone        String?
  timezone     String?  @default("UTC")
  workSchedule Json?
  managerId    String?
  manager      User?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("EmployeeManager")
  organizations UserOrganization[]
  leaveRequests LeaveRequest[] @relation("LeaveApplicant")
  leaveReviews  LeaveRequest[] @relation("LeaveReviewer")
  leaveBalances LeaveBalance[]
  attendance    AttendanceRecord[]
  notifications Notification[]
  taskComments  TaskComment[]
  intakeAssigned IntakeRequest[] @relation("IntakeAssignee")
  intakeCreated  IntakeRequest[] @relation("IntakeCreator")
  enrollmentActivities EnrollmentActivity[]
  enrollmentActivityReads EnrollmentActivityRead[]
  enrollmentApprovalsCreated EnrollmentApprovalDetails[] @relation("ApprovalCreator")
  enrollmentApprovalsUpdated EnrollmentApprovalDetails[] @relation("ApprovalUpdater")
  @@index([managerId])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditEvents  AuditEvent[]
  tasks        Task[]   @relation("TaskAssignee")
  createdTasks Task[]   @relation("TaskCreator")
  createdDocuments Document[] @relation("DocumentCreator")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id             String   @id @default(cuid())
  legalName      String
  dba            String?
  taxId          String?
  establishedAt  DateTime?
  status         RecordStatus @default(ACTIVE)
  contactName    String?
  contactTitle   String?
  phone          String?
  fax            String?
  email          String?
  mailingAddress Json?
  ownership      Json?
  bankName       String?
  bankAccountTitle String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankContactName String?
  bankContactPhone String?
  bankContactEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  practices      Practice[]
  facilities     Facility[]
  providerAffiliations ProviderOrganization[]
  enrollments    EnrollmentApplication[]
  documents      Document[]
  auditEvents    AuditEvent[]
  members        UserOrganization[]
  tasks          Task[]
  intakeRequests IntakeRequest[]
}

model Practice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  legalName      String?
  npi            String?
  taxId          String?
  dba            String?
  taxonomyCode   String?
  establishedAt  DateTime?
  contactName    String?
  contactTitle   String?
  phone          String?
  fax            String?
  email          String?
  mailingAddress Json?
  primaryAddress Json?
  bankName       String?
  bankAccountTitle String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankContactName String?
  bankContactPhone String?
  bankContactEmail String?
  status         RecordStatus @default(ACTIVE)
  owners         PracticeOwner[]
  providers      ProviderPractice[]
  facilities     Facility[]
  cases          CredentialingCase[]
  enrollments    EnrollmentApplication[]
  documents      Document[]
  tasks          Task[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
  @@index([npi])
}

model PracticeOwner {
  id                 String   @id @default(cuid())
  practiceId         String
  practice           Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name               String
  ownershipPercent   Decimal  @db.Decimal(5, 2)
  ssn                String?
  dateOfBirth        DateTime?
  ownershipDate      DateTime?
  placeOfBirth       String?
  address            Json?
  phone              String?
  fax                String?
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([practiceId])
}

enum ContactKind {
  PERSON
  ORGANIZATION
}

model Facility {
  id          String   @id @default(cuid())
  practiceId  String?
  practice    Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name        String
  npi         String?
  contactName String?
  contactTitle String?
  phone       String?
  fax         String?
  email       String?
  address     Json?
  schedule    Json?
  status      RecordStatus @default(ACTIVE)
  providers   ProviderFacility[]
  contacts    FacilityContact[]
  documents   Document[]
  documentLinks DocumentFacility[]
  enrollments EnrollmentApplication[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([practiceId])
  @@index([organizationId])
}

model FacilityContact {
  id               String      @id @default(cuid())
  facilityId       String
  facility         Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  kind             ContactKind @default(PERSON)
  name             String?
  title            String?
  organizationName String?
  email            String?
  phone            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@index([facilityId, kind])
}

model Provider {
  id                 String   @id @default(cuid())
  firstName          String
  middleName         String?
  lastName           String
  npi                String?  @unique
  dateOfBirth        DateTime?
  placeOfBirth       String?
  ssn                String?
  citizenship        String?
  gender             String?
  email              String?
  homePhone          String?
  workPhone          String?
  address            Json?
  primarySpecialty   String?
  secondarySpecialty String?
  taxonomyCode       String?
  professionalType   String?
  supervisorName     String?
  status             RecordStatus @default(PENDING)
  licenses           License[]
  practices          ProviderPractice[]
  organizations      ProviderOrganization[]
  facilities         ProviderFacility[]
  cases              CredentialingCase[]
  enrollments        EnrollmentApplication[]
  documents          Document[]
  documentLinks      DocumentProvider[]
  tasks              Task[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([lastName, firstName])
  @@index([status])
}

model ProviderPractice {
  providerId String
  practiceId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  affiliationTitle String?
  effectiveAt DateTime?
  endAt DateTime?
  @@id([providerId, practiceId])
}

model ProviderFacility {
  providerId String
  facilityId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  approvalStatus String?
  effectiveAt DateTime?
  endAt DateTime?
  @@id([providerId, facilityId])
}

model ProviderOrganization {
  id             String @id @default(cuid())
  providerId     String
  organizationId String
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affiliationTitle String?
  effectiveAt    DateTime?
  endAt          DateTime?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([providerId, organizationId])
  @@index([organizationId, status])
}

model License {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type        String
  number      String?
  state       String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  status      DocumentStatus @default(RECEIVED)
  issuingBody String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([providerId, expiresAt])
}

model Document {
  id             String @id @default(cuid())
  title          String
  type           String
  category       String?
  status         DocumentStatus @default(RECEIVED)
  storageKey     String?
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  issuedAt       DateTime?
  expiresAt      DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?
  ignored        Boolean @default(false)
  required       Boolean @default(false)
  reportingRequired Boolean @default(false)
  warningDays    Int?
  policyNumber   String?
  perOccurrence  Decimal? @db.Decimal(14, 2)
  aggregate      Decimal? @db.Decimal(14, 2)
  insuranceCompany String?
  namedInsured   String?
  // Banking credential fields (Bank Letter / Voided Check). Sensitive values encrypted at rest.
  bankName         String?
  bankTitle        String?
  bankRoutingNumber String?
  bankAccountType  String?
  bankPhoneNumber  String?
  bankAccountHolder String?
  uploadedAt       DateTime?
  createdById    String?
  createdBy      User? @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  practiceId     String?
  practice       Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  facilityId     String?
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  enrollment     EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  documentFacilities DocumentFacility[]
  documentProviders  DocumentProvider[]
  activityAttachments EnrollmentActivityAttachment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([type, status])
  @@index([category, status])
  @@index([expiresAt])
  @@index([facilityId, category])
  @@index([enrollmentId])
}

model DocumentFacility {
  documentId String
  facilityId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@id([documentId, facilityId])
  @@index([facilityId])
}

model DocumentProvider {
  documentId String
  providerId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@id([documentId, providerId])
  @@index([providerId])
}

model CredentialingCase {
  id          String @id @default(cuid())
  caseNumber  String @unique
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  practiceId  String?
  practice    Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  status      CaseStatus @default(DRAFT)
  assignedTo  String?
  dueAt       DateTime?
  submittedAt DateTime?
  decisionAt  DateTime?
  decisionBy  String?
  decisionReason String?
  checklist   Json?
  notes       String?
  statusHistory StatusHistory[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, dueAt])
}

model Payer {
  id        String @id @default(cuid())
  name      String
  payerCode String?
  website   String?
  phone     String?
  status    RecordStatus @default(ACTIVE)
  plans     PayerPlan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, payerCode])
}

model PayerPlan {
  id        String @id @default(cuid())
  payerId   String
  payer     Payer @relation(fields: [payerId], references: [id], onDelete: Cascade)
  name      String
  planType  String?
  checklist Json?
  enrollments EnrollmentApplication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([payerId, name])
}

model EnrollmentApplication {
  id            String @id @default(cuid())
  applicationNo String @unique
  subject       String?
  providerId    String?
  provider      Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  practiceId    String?
  practice      Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  payerPlanId   String
  payerPlan     PayerPlan @relation(fields: [payerPlanId], references: [id], onDelete: Restrict)
  status        EnrollmentStatus @default(NOT_STARTED)
  assignedTo    String?
  dueAt         DateTime?
  submittedAt   DateTime?
  referenceNo   String?
  lastFollowUpAt DateTime?
  nextFollowUpAt DateTime?
  effectiveAt   DateTime?
  revalidationAt DateTime?
  decisionAt    DateTime?
  decisionReason String?
  checklist     Json?
  notes         String?
  highlighted   Boolean  @default(false)
  statusHistory StatusHistory[]
  tasks         Task[]
  activities    EnrollmentActivity[]
  approvalDetails EnrollmentApprovalDetails?
  documents     Document[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, nextFollowUpAt])
  @@index([organizationId, status])
  @@index([providerId, payerPlanId])
  @@index([facilityId, status])
  @@index([highlighted])
}

model EnrollmentActivity {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   EnrollmentApplication @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  activityType String   @default("MESSAGE")
  metadata     Json?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attachments  EnrollmentActivityAttachment[]
  reads        EnrollmentActivityRead[]
  @@index([enrollmentId, createdAt])
  @@index([enrollmentId, deletedAt])
  @@index([authorId, createdAt])
}

model EnrollmentActivityAttachment {
  id         String @id @default(cuid())
  activityId String
  activity   EnrollmentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([activityId, documentId])
  @@index([documentId])
}

model EnrollmentActivityRead {
  id         String   @id @default(cuid())
  activityId String
  activity   EnrollmentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())
  @@unique([activityId, userId])
  @@index([userId, readAt])
}

model EnrollmentApprovalDetails {
  id                String   @id @default(cuid())
  enrollmentId      String   @unique
  enrollment        EnrollmentApplication @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payerEnrollmentId String?
  effectiveAt       DateTime?
  revalidationAt    DateTime?
  notes             String?
  createdById       String?
  createdBy         User?    @relation("ApprovalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?    @relation("ApprovalUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Task {
  id             String @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  priority       Priority @default(NORMAL)
  dueAt          DateTime?
  assignedToId   String?
  assignedTo     User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  practiceId     String?
  practice       Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  facilityId     String?
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  caseId         String?
  credentialingCase CredentialingCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  enrollment     EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, dueAt])
  @@index([organizationId, status])
  @@index([assignedToId, status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

model StatusHistory {
  id           String @id @default(cuid())
  fromStatus   String?
  toStatus     String
  changedBy    String?
  reason       String?
  caseId       String?
  credentialingCase CredentialingCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   EnrollmentApplication? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([caseId, createdAt])
  @@index([enrollmentId, createdAt])
}

model AuditEvent {
  id             String @id @default(cuid())
  actorId        String?
  actor          User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

enum IntakeStatus {
  DRAFT
  SENT
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CONVERTED
  CANCELLED
}

enum IntakeKind {
  PROVIDER
  PRACTICE
  FACILITY
  ORGANIZATION
  COMBINED
}

model IntakeRequest {
  id               String       @id @default(cuid())
  referenceNo      String       @unique
  kind             IntakeKind   @default(PROVIDER)
  status           IntakeStatus @default(DRAFT)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?        @relation("IntakeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?        @relation("IntakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  payload          Json?
  missingFields    Json?
  convertedProviderId  String?
  convertedPracticeId  String?
  convertedFacilityId  String?
  convertedOrganizationId String?
  sentAt           DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  convertedAt      DateTime?
  notes            String?
  events           IntakeEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@index([assignedToId, status])
}

model IntakeEvent {
  id        String   @id @default(cuid())
  intakeId  String
  intake    IntakeRequest @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?
  detail    Json?
  createdAt DateTime @default(now())
  @@index([intakeId, createdAt])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  paid        Boolean  @default(true)
  annualDays  Decimal? @db.Decimal(5, 2)
  active      Boolean  @default(true)
  requests    LeaveRequest[]
  balances    LeaveBalance[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([userId, startDate])
  @@index([status, startDate])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  entitled    Decimal   @db.Decimal(5, 2)
  used        Decimal   @db.Decimal(5, 2) @default(0)
  @@unique([userId, leaveTypeId, year])
  @@index([userId, year])
}

model AttendanceRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate      DateTime  @db.Date
  checkInAt     DateTime?
  checkOutAt    DateTime?
  breakMinutes  Int       @default(0)
  lateMinutes   Int       @default(0)
  earlyMinutes  Int       @default(0)
  workedMinutes Int?
  notes         String?
  corrected     Boolean   @default(false)
  correctionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([userId, workDate])
  @@index([workDate])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String?
  entityType String?
  entityId  String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}
