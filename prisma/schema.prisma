  /// Snapshot of readiness overall/dimensions at last assessment (non-sensitive).
  readinessSnapshot    Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  @@index([tenantId, providerId, status])
  @@index([tenantId, status])
  @@index([providerId, updatedAt])
}

/// Phase 3D � On-demand credentialing QA scan run (not a background scheduler).
model CredentialingQaScan {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  startedById         String?
  /// RUNNING | COMPLETED | FAILED | PARTIAL
  status              String   @default("RUNNING")
  recordsInspected    Int      @default(0)
  providersInspected  Int      @default(0)
  findingsCreated     Int      @default(0)
  findingsUpdated     Int      @default(0)
  findingsBySeverity  Json?
  /// Non-sensitive summary / limits / continuation cursor.
  summary             Json?
  /// Safe error message � never store secrets or full license numbers.
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

/// Phase 4D � external credentialing integration registry (foundation only).
/// CONNECTED requires an actual successful connection test. Manual portal ? API connected.
enum ExternalIntegrationType {
  CAQH
  PECOS
  AVAILITY
  PAYER_PORTAL
  OTHER
}

enum ExternalIntegrationStatus {
  NOT_CONFIGURED
  PENDING_APPROVAL
  PENDING_CREDENTIALS
  READY_FOR_CONNECTION_TEST
  CONNECTED
  DEGRADED
  DISCONNECTED
  DISABLED
  NOT_SUPPORTED
  MANUAL_ONLY
  /// Isolated automated-test mock success only — never a live verified connection.
  TEST_MOCK_SUCCEEDED
}

enum ExternalConnectionMode {
  OFFICIAL_API
  AUTHORIZED_PARTNER
  MANUAL_PORTAL
  FILE_IMPORT_EXPORT
  NOT_AVAILABLE
}

enum ProviderIntegrationAuthStatus {
  NOT_REQUESTED
  REQUESTED
  GRANTED
  EXPIRED
  REVOKED
  REJECTED
}

enum ExternalOperationStatus {
  QUEUED
  IN_PROGRESS
  SUCCEEDED
  FAILED
  CANCELLED
  NOT_SUPPORTED
  REQUIRES_MANUAL_ACTION
}

model ExternalIntegration {
  id                   String                    @id @default(cuid())
  /// null = platform-wide catalog/config; set = tenant-specific configuration.
  tenantId             String?
  tenant               Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationType      ExternalIntegrationType
  displayName          String
  systemName           String
  status               ExternalIntegrationStatus @default(NOT_CONFIGURED)
  connectionMode       ExternalConnectionMode    @default(NOT_AVAILABLE)
  /// Capability map: { CAPABILITY: { status, source, notes } }
  capabilities         Json                      @default("{}")
  /// Opaque secret reference only (e.g. env:KEY or aws:arn/name). Never plaintext secrets.
  credentialSecretRef  String?
  credentialConfiguredAt DateTime?
  credentialConfiguredById String?
  credentialConfiguredBy User?                   @relation("ExternalIntegrationConfigurator", fields: [credentialConfiguredById], references: [id], onDelete: SetNull)
  feasibilityNotes     String?
  officialSourceUrl    String?
  lastVerifiedAt       DateTime?
  lastTestedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  lastErrorSummary     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  authorizations       ProviderIntegrationAuthorization[]
  operations           ExternalIntegrationOperation[]
  @@index([tenantId, integrationType])
  @@index([integrationType, status])
  @@index([status])
  @@index([credentialConfiguredById])
}

model ProviderIntegrationAuthorization {
  id                 String                         @id @default(cuid())
  tenantId           String
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId         String
  provider           Provider                       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  integrationId      String
  integration        ExternalIntegration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  authorizationType  String                         @default("DELEGATION")
  status             ProviderIntegrationAuthStatus  @default(NOT_REQUESTED)
  grantedAt          DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  grantedById        String?
  grantedBy          User?                          @relation("ProviderIntegrationAuthGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  evidenceDocumentId String?
  evidenceDocument   Document?                      @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  externalReference  String?
  /// Capability scopes authorized (string array in JSON).
  scope              Json                           @default("[]")
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  events             ProviderIntegrationAuthorizationEvent[]
  @@index([tenantId, providerId])
  @@index([providerId, integrationId])
  @@index([integrationId, status])
  @@index([status, expiresAt])
  @@index([evidenceDocumentId])
}

model ProviderIntegrationAuthorizationEvent {
  id               String                           @id @default(cuid())
  authorizationId  String
  authorization    ProviderIntegrationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  fromStatus       ProviderIntegrationAuthStatus?
  toStatus         ProviderIntegrationAuthStatus
  actorId          String?
  actor            User?                            @relation("ProviderIntegrationAuthEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason           String?
  metadata         Json?
  createdAt        DateTime                         @default(now())
  @@index([authorizationId, createdAt])
}

model ExternalIntegrationOperation {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationId     String
  integration       ExternalIntegration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  providerId        String?
  provider          Provider?                @relation(fields: [providerId], references: [id], onDelete: SetNull)
  enrollmentId      String?
  enrollment        EnrollmentApplication?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  operationType     String
  operationStatus   ExternalOperationStatus  @default(QUEUED)
  externalReference String?
  idempotencyKey    String?
  startedAt         DateTime                 @default(now())
  completedAt       DateTime?
  initiatedById     String?
  initiatedBy       User?                    @relation("ExternalIntegrationOperationInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  safeErrorCode     String?
  safeErrorSummary  String?
  /// Non-sensitive metadata only � never store secrets or full PHI payloads.
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, integrationId])
  @@index([integrationId, operationStatus])
  @@index([providerId, createdAt])
  @@index([enrollmentId, createdAt])
  @@index([operationStatus, createdAt])
}

/// Phase 4E � payer enrollment revalidation (separate from credential expiration).
enum EnrollmentRevalidationStatus {
  NOT_STARTED
  UPCOMING
  PREPARING
  READY_FOR_INTERNAL_REVIEW
  SUBMITTED
  ACKNOWLEDGED
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  COMPLETED
  DENIED
  OVERDUE
  CANCELLED
}

enum RevalidationDueDateSource {
  CONFIRMED
  ESTIMATED
  MANUAL
  PAYER_NOTICE
  OTHER
}

model EnrollmentRevalidation {
  id                   String                        @id @default(cuid())
  tenantId             String
  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollmentId         String
  enrollment           EnrollmentApplication         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  providerId           String?
  provider             Provider?                     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  payerId              String?
  payer                Payer?                        @relation(fields: [payerId], references: [id], onDelete: SetNull)
  payerPlanId          String?
  payerPlan            PayerPlan?                    @relation(fields: [payerPlanId], references: [id], onDelete: SetNull)
  /// MEDICARE_REVALIDATION | MEDICAID_REVALIDATION | COMMERCIAL_REVALIDATION | GROUP_REVALIDATION | FACILITY_REVALIDATION | OTHER
  revalidationType     String
  referenceNumber      String?
  dueDate              DateTime?
  dueDateSource        RevalidationDueDateSource     @default(MANUAL)
  notificationDate     DateTime?
  initiatedAt          DateTime?
  submittedAt          DateTime?
  acknowledgedAt       DateTime?
  completedAt          DateTime?
  effectiveDate        DateTime?
  status               EnrollmentRevalidationStatus  @default(NOT_STARTED)
  assignedToId         String?
  assignedTo           User?                         @relation("RevalidationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  source               String?
  sourceReference      String?
  notes                String?
  internalNotes        String?
  evidenceDocumentId   String?
  evidenceDocument     Document?                     @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  submissionConfirmed  Boolean                       @default(false)
  denialReason         String?
  cancellationReason   String?
  createdById          String?
  createdBy            User?                         @relation("RevalidationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  events               EnrollmentRevalidationEvent[]
  @@index([tenantId, enrollmentId])
  @@index([tenantId, status, dueDate])
  @@index([providerId, dueDate])
  @@index([payerId, status])
  @@index([assignedToId, dueDate])
  @@index([enrollmentId, revalidationType, status])
  @@index([evidenceDocumentId])
}

model EnrollmentRevalidationEvent {
  id               String                       @id @default(cuid())
  revalidationId   String
  revalidation     EnrollmentRevalidation       @relation(fields: [revalidationId], references: [id], onDelete: Cascade)
  fromStatus       EnrollmentRevalidationStatus?
  toStatus         EnrollmentRevalidationStatus
  actorId          String?
  actor            User?                        @relation("RevalidationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason           String?
  eventType        String?
  metadata         Json?
  createdAt        DateTime                     @default(now())
  @@index([revalidationId, createdAt])
}
