NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/credentialing_db?schema=public"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRES_IN=8h

# AES-256 field encryption for sensitive banking credential values (routing numbers).
# Prefer 32 random bytes as hex (64 chars) or base64. Required in production.
# FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Local demo accounts only; change this before running the seed script
SEED_DEFAULT_PASSWORD="LocalDemo-ChangeThis-2026!"

# Required for automatic employee welcome emails (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Credentialing Workspace <onboarding@your-verified-domain.com>"
APP_LOGIN_URL="http://localhost:5173/login"
