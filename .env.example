NODE_ENV=development
PORT=4000
# Required in production (explicit https origin; localhost forbidden in production).
# Comma-separated allowed. No trailing slash. Must include the Vercel frontend origin.
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/credentialing_db?schema=public"
# If the DB password contains @ # : / ? etc, URL-encode it (e.g. @ → %40).
# On Vercel + Supabase prefer the pooler user host form and pgbouncer=true.
# DIRECT_URL is used by Prisma migrations (session mode / non-pooler).
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/credentialing_db?schema=public"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRES_IN=8h

# Cross-origin SPA ↔ API (separate Vercel projects): required for browser cookie auth.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=1
# Or set CROSS_SITE_COOKIES=1 (auto SameSite=None; Secure). Do not set COOKIE_DOMAIN across *.vercel.app.
# TRUST_PROXY=1

# AES-256 field encryption for sensitive banking credential values (routing numbers).
# Prefer 32 random bytes as hex (64 chars) or base64. Required at production startup (≥32 chars).
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Never set in production (startup refuses). Isolated test fixtures only:
# FIELD_ENCRYPTION_ALLOW_PLAINTEXT_TEST=1

# Forbidden in production (startup refuses):
# E2E_SAFE_DATABASE=1
# INTEGRATION_TEST_MOCK=1
# CAQH_ALLOW_MOCK_CONNECT=1
# FIELD_ENCRYPTION_ALLOW_PLAINTEXT_TEST=1

# Playwright E2E (frontend) — set when PLAYWRIGHT_E2E=1; never reuse production JWT_SECRET:
# E2E_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/credentialing_e2e?schema=public"
# E2E_JWT_SECRET="REPLACE_WITH_DEDICATED_TEST_ONLY_SECRET_AT_LEAST_32_CHARS"
# Prepare isolated DB: npm run e2e:db:prepare

# Local demo accounts only; change this before running the seed script
SEED_DEFAULT_PASSWORD="LocalDemo-ChangeThis-2026!"

# Required for automatic employee welcome emails (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Credentialing Workspace <onboarding@credentialing.com>"
APP_LOGIN_URL="http://localhost:5173/login"
